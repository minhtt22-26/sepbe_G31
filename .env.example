NODE_ENV=development
APP_PORT=4000
APP_API_PREFIX=api
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=

#JWT
AUTH_JWT_ACCESS_SECRET = 
AUTH_JWT_ACCESS_TOKEN_EXPIRED = 
AUTH_JWT_REFRESH_SECRET = 
AUTH_JWT_REFRESH_TOKEN_EXPIRED =

AUTH_JWT_AUDIENCE = 
AUTH_JWT_ISSUER = 

FORGOT_PASSWORD_BASE_URL=

# Cloudinary
CLOUDINARY_NAME=xxxxx
CLOUDINARY_KEY=xxxxx
CLOUDINARY_SECRET=xxxxx

#EMAIL
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

#Google
AUTH_SOCIAL_GOOGLE_CLIENT_ID=
AUTH_SOCIAL_GOOGLE_CLIENT_SECRET=

#Redis
REDIS_URL=redis://default:password@host:port

#Gemini (AI job matching — get key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_LLM_MODEL=gemini-2.5-flash-lite
GEMINI_LLM_TEMPERATURE=0

#SePay (Boost payment)
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_CODE=ICB
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_ORDER_PREFIX=SEVQR
SEPAY_WEBHOOK_URL=https://yourdomain.com/api/wallet/topup/sepay/webhook

# Optional
ADMIN_ALERT_EMAIL=admin@yourdomain.com
# NODE_OPTIONS=--dns-result-order=ipv4first   # Uncomment when deploying on Railway

